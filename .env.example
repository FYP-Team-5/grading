# Copy to .env before running Docker Compose.
API_PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional inbound API authentication for frontend requests.
API_KEY=
CORS_ORIGINS=*

# Credentials and collection must match the existing rubric RAG Compose project.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
QDRANT_API_KEY=
QDRANT_COLLECTION=rubric_chunks
QDRANT_TIMEOUT_SECONDS=30

# OpenAI-compatible LLM endpoint running on the Docker host (for example Ollama).
LLM_URL=http://host.docker.internal:11434/v1/chat/completions
LLM_MODEL=local-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

MAX_ANSWER_CHARACTERS=50000
