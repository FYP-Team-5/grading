# Copy to .env before running Docker Compose.
API_PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional inbound API authentication for frontend requests.
API_KEY=
CORS_ORIGINS=*

# Existing rubric RAG service. This host address works from the grading container.
RAG_URL=http://host.docker.internal:8000
RAG_API_KEY=
RAG_TIMEOUT_SECONDS=30
RAG_MAX_RETRIES=2
RETRIEVAL_K=8
# Leave blank to accept all similarity scores.
RETRIEVAL_SCORE_THRESHOLD=

# OpenAI-compatible LLM endpoint running on the Docker host (for example Ollama).
LLM_URL=http://host.docker.internal:11434/v1/chat/completions
LLM_MODEL=local-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

MAX_ANSWER_CHARACTERS=50000
